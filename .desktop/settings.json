{
    "name": "Pixel Art Academy Learn Mode",
    "version": "0.39.1",
    "devTools": false,
    "devtron": true,
    "desktopHCP": false,
    "desktopHCPIgnoreCompatibilityVersion": false,
    "webAppStartupTimeout": 30000,
    "exposeLocalFilesystem": true,
    "window": {
        "minWidth": 640,
        "minHeight": 510,
        "fullscreen": false,
        "fullscreenable": true,
        "autoHideMenuBar": true,
        "icon": "@assets/icons/learnmode-a.png",
        "backgroundColor": "#000000",
        "_windows": {
            "icon": "@assets/icons/learnmode-a.ico"
        }
    },
    "uglify": false,
    "plugins": {},
    "dependencies": {
        "steamworks.js": "0.4.0"
    },
    "devDependencies": {
        "electron": "41.2.2"
    },
    "packageJsonFields": {
        "author": "Retronator",
        "private": true,
        "devDependencies": {
            "electron": "41.2.2"
        }
    },
    "packagerOptions": {
        "appBundleId": "com.retronator.pixelartacademy-learnmode",
        "icon": ".desktop/assets/icons/learnmode-a.ico",
        "_osx": {
            "icon": ".desktop/assets/icons/learnmode-a-squircle.icns"
        },
        "darwinDarkModeSupport": true,
        "appCategoryType": "public.app-category.education",
        "appCopyright": "Copyleft (AGPL-3.0 & CC-SA) 2025 Matej Jan, Retronator",
        "overwrite": true,
        "electronVersion": "41.2.2",
        "platform": "darwin, win32, linux",
        "arch": "universal,x64",
        "osxUniversal": {
            "mergeASARs": true,
            "x64ArchFiles": "**/steamworks.js/**"
        },
        "osxSign": {
            "hardenedRuntime": true,
            "entitlements": ".desktop/entitlements.plist"
        }
    }
}
