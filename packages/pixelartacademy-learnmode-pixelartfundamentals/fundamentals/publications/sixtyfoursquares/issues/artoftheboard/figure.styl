@import "{retronator:retronator-identity}/style/style.import"
@import "{retronator:pixelartacademy-pixelpad-drawing}/editor/desktop/desktop.import"
@import "{retronator:pixelartacademy-learnmode-pixelartfundamentals}/fundamentals/publications/sixtyfoursquares/sixtyfoursquares.import"
@import "{retronator:pixelartacademy-learnmode-pixelartfundamentals}/fundamentals/publications/sixtyfoursquares/issues/artoftheboard/artoftheboard.import"

.publication.sixty-four-squares.art-of-the-board
  .pixelartacademy-publication-article-figure
    .elements
      &.screenshots
        .element
          .pixelartacademy-publication-article-figure-image
            .cutout
              inset -7rem

      .element
        .pixelartacademy-publication-article-figure-image
          height content-fit

          &:hover
            z-index 2

          .cutout
            &::before
              border 1rem dashed artOfTheBoardColorCutout

            .cut-icon
              background url('/pixelartacademy/learnmode/pixelartfundamentals/fundamentals/publications/sixtyfoursquares/issues/artoftheboard/scissors.png') 100% 100% / 100%

          .credit
            color artOfTheBoardColor
