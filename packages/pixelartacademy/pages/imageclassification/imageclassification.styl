@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pages-imageclassification
  .main-area
    display flex

    .canvas-area
      width 600px
      height 600px
      background white

      .canvas
        width 100%
        height 100%
        pixel-image-rendering()
        cursor crosshair

    .results-area
      display flex

      .classifier-results
        width 200px

        h3
          margin-top 0

        .results
          padding-left 20px
