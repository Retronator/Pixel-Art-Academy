@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pages-pixelimageclassification
  .main-area
    display flex
    align-items flex-start
    gap 24px

    .canvas-area
      width 600px
      height 600px
      background white

      .preview-canvas
        width 100%
        height 100%
        pixel-image-rendering()
        cursor crosshair

    .curves-area
      max-width 10vw

    .results-area
      display flex

      .classifier-results
        width 200px

        h3
          margin-top 0

        .results
          padding-left 20px
