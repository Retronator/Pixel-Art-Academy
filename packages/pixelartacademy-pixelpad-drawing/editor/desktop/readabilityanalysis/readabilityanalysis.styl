@import "{retronator:retronator-identity}/style/style.import"
@import "{retronator:pixelartacademy-pixelpad-drawing}/editor/desktop/desktop.import"

paperColor = atariGray(7)
printColor = atariIndigo(1)
penColor = atariCyan(3)

.pixelartacademy-pixelpad-apps-drawing-editor-desktop-readabilityanalysis
  position absolute
  right 0
  bottom 0
  z-index 14
  transform translate(calc(100% + 10rem), calc(100% + 10rem))
  cursor pointer

  &.active
    transform translate(0, 0)
    right calc(50% - 130rem)
    cursor default

    .paper
      .sheet
        filter drop-shadow(-20rem 5rem 0 desktopShadowColor)

  .paper
    position relative
    width 260rem
    transition all 0.2s
    color printColor
    checkout()
    line-height 8rem

    .sheet
      content ''
      display block
      absolute-cover()
      border-style solid
      border-width 42rem 16rem 0
      border-image image('/pixelartacademy/pixelpad/apps/drawing/editor/desktop/readabilityanalysis/paper.png') 42 16 0 fill repeat
      filter drop-shadow(-1rem 1rem 0 desktopShadowColor)
      transition all 0.2s

    .content-placeholder
      transition all 0.5s

    .content
      position absolute
      z-index 1
      top 0
      left 0
      right 0
      padding 7rem 20rem 3rem

      .header
        height 27rem

        .pixeltosh
          float left
          position relative
          left -1rem
          width 20rem
          height 23rem
          background-image image('/pixelartacademy/pixelpad/apps/drawing/editor/desktop/readabilityanalysis/pixeltosh.png')

        .title
          position relative
          left 3rem
          top 9rem
          text-transform uppercase

  .pixelartacademy-pixelpad-apps-drawing-editor-desktop.drawing-active:not(.focused-mode) &
    transform translate(calc(100% - 42rem), calc(100% - 31rem))

    &:hover:not(.active)
      .paper
        transform translate(-4rem, -4rem)

        .sheet
          filter drop-shadow(-8rem 2rem 0 desktopShadowColor)
