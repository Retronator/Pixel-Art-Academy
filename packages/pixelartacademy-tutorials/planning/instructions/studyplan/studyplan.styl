@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-tutorials-planning-instructions-studyplan
  .lotus
    position absolute
    z-index 11
    right -150rem
    bottom 25rem
    width 146rem
    height 48rem
    background-image image('/pixelartacademy/tutorials/planning/instructions/studyplan/lotus.png')

    &.center
      right 5rem
      transition right 1.5s ease-out

    &.left
      right 500rem
      transition right 2.5s ease-in

    &.open::before
      content ''
      position absolute
      width 52rem
      height 46rem
      top 6rem
      left 58rem
      background-image image('/pixelartacademy/tutorials/planning/instructions/studyplan/lotus-open.png')

    &:not(.open)::before
      content ''
      position absolute
      width 35rem
      height 25rem
      top 16rem
      left 59rem
      background-image image('/pixelartacademy/tutorials/planning/instructions/studyplan/lotus-closed.png')

    &.driving::after
      content ''
      position absolute
      width 81rem
      height 9rem
      top 35rem
      left 42rem
      background-image image('/pixelartacademy/tutorials/planning/instructions/studyplan/lotus-driving.png')

    .pixelartacademy-pixelpad-components-speechballoon
      position absolute
      left 88rem
      bottom 44rem
      pointer-events none
      adventure()
      color atariGray(0)

      .content-measuring
        min-width auto !important
        width 120rem

  .pixelartacademy-pixelpad-systems-instructions-interfacemarking
    z-index 9 !important
