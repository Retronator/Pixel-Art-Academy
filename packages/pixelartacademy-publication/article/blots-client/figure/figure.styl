@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-publication-article-figure
  white-space normal
  margin 0 auto 7rem
  padding-top 7rem
  width 100%
  break-inside avoid

  &:has(.float-left)
    float left

  &:has(.float-right)
    float right

  &:has(.quarter-width)
    width 25%

  &:has(.third-width)
    width 33%

  &:has(.width-40)
    width 40%

  &:has(.width-45)
    width 45%

  &:has(.half-width)
    width 50%

  &:has(.width-55)
    width 55%

  &:has(.width-60)
    width 60%

  &:has(.two-thirds-width)
    width 66%

  &:has(.inline)
    display inline-block

  .elements
    width 100%

    .elements-row
      display flex
      width 100%
      margin 0

      &:first-child
        padding-top 0

      .element
        position relative
        flex-basis 0

        &:first-child
          padding-left 0

        &:only-child
          flex-grow 1 !important

        .actions
          position absolute
          z-index 1
          top 0
          right 0

  .caption
    padding 5rem 3rem 3rem
    text-align center
    line-height 8rem

    textarea
      width 100%
      font inherit

  .style
    width 50%
