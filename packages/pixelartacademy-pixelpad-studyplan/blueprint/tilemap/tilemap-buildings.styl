@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixelpad-apps-studyplan-blueprint-tilemap
  .tile
    .building
      for i in 1..6
        &.sim-city-residential-{i}
          .shadow
          .image
            background-position 0 ((i - 1) * -20)rem

        &.sim-city-church
          .shadow
          .image
            background-position 0 -120rem

        &.sim-city-subway
          .shadow
          .image
            background-position 0 -140rem

        &.sim-city-water-pump
          .shadow
          .image
            background-position 0 -160rem

        &.sim-city-park
          .shadow
          .image
            background-position 0 -180rem

      for i in 1..4
        &.sim-city-commercial-{i}
          .shadow
          .image
            background-position -30rem ((i - 1) * -20)rem

      for i in 1..4
        &.sim-city-industrial-{i}
          .shadow
          .image
            background-position -30rem ((i + 3) * -20)rem

        &.sim-city-wind-turbine
          .shadow
          .image
            background-position -30rem -160rem

      for i in 1..3
        &.sim-city-office-{i}
          .shadow
          .image
            height 26rem
            background-position -60rem ((i - 1) * -30 - 4)rem

      &.transport-tycoon-house-1
        .shadow
        .image
          background-position -60rem -90rem

      &.transport-tycoon-cinema
        .shadow
        .image
          background-position -60rem -110rem

      for i in 2..4
        &.transport-tycoon-house-{i}
          .shadow
          .image
            background-position -60rem ((i - 2) * -20 - 130)rem

      for i in 1..4
        &.transport-tycoon-houses-{i}
          .shadow
          .image
            background-position -90rem ((i - 1) * -20)rem

      &.transport-tycoon-church
        .shadow
        .image
          background-position -90rem -80rem

      for i in 1..3
        &.transport-tycoon-office-{i}
          .shadow
          .image
            height 26rem
            background-position -90rem ((i - 1) * -30 - 104)rem

      &.transport-tycoon-office-4
        .shadow
        .image
          height 26rem
          background-position -120rem -4rem

      for i in 1..4
        &.transport-tycoon-flats-{i}
          .shadow
          .image
            background-position -120rem ((i - 1) * -20 - 30)rem

      for i in 1..2
        &.transport-tycoon-shops-{i}
          .shadow
          .image
            background-position -120rem ((i - 1) * -20 - 110)rem

      &.transport-tycoon-theater
        .shadow
        .image
          background-position -120rem -150rem

      &.transport-tycoon-warehouse
        .shadow
        .image
          background-position -120rem -170rem

      for i in 1..2
        &.transport-tycoon-park-{i}
          .shadow
          .image
            background-position -150rem ((i - 1) * -20)rem

      &.transport-tycoon-bus-station
        .shadow
        .image
          background-position -150rem -40rem

      &.transport-tycoon-depot
        .shadow
        .image
          background-position -150rem -60rem

      &.county-line-sign
        .shadow
        .image
          background-position -150rem -80rem
