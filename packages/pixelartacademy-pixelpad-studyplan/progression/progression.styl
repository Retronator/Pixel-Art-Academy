@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixelpad-apps-studyplan-progression
  absolute-cover()
  z-index 10

  .panel-area
    position absolute
    left calc(50% - 160rem)
    top calc(50% - 90rem)
    width 320rem
    height 180rem

    .panel
      position absolute
      left 0
      top 50%
      width 100%
      height 0
      border 1rem solid atariCyan(2)
      box-shadow -5rem 5rem 0 rgba(atariGray(0), 0.5)
      transition all 0.5s cubic-bezier(0.5, 0, 1, 0)
      visibility hidden
      overflow hidden
      background-color atariCyan(1)

      &.displayed
        top 0
        height 100%
        visibility visible

      .intro
        height 100%

        &.timelapse-played
          background image('/pixelartacademy/pixelpad/apps/studyplan/intro.png') center center / 320rem 180rem

        .timelapse
        .result
          absolute-cover()

        .timelapse
          background-position center center
          background-size 320rem 180rem
          cursor pointer

        .controls
         position absolute
         bottom 10rem
         left calc(50% - 32.5rem)
         width 65rem

      .level-progression
        display flex
        height 100%
        padding 2rem
        flex-direction column
        text-align center
        background image('/pixelartacademy/pixelpad/apps/studyplan/intro.png') center center / 320rem 180rem

        .title
          margin 0 0 2rem
          padding 2rem
          background atariCyan(2)
          color atariCyan(6)
          text-transform uppercase
          acme-9()

        .levels
          display flex
          list-style none
          padding 0
          margin 0
          flex-grow 1
          gap 2rem

          .level
            position relative
            padding 2rem 2rem 6rem
            flex-grow 1
            flex-basis 0

            &.unlocking
              background rgba(atariCyan(0), 0.25)

            &.revealed
              background atariCyan(0)

            .number
              padding 1rem 0
              background atariCyan(2)
              color atariCyan(6)
              text-transform uppercase
              uni()
              line-height 7rem

            .name
              margin 8rem 3rem 5rem
              text-transform uppercase
              thintel()
              line-height 11rem

            .description
              margin 0 3rem
              uni()
              line-height 9rem

            .start-button
              width 65rem
              margin-top 10rem

            .unlock-button
              position absolute
              top calc(50% - 4.5rem)
              left calc(50% - 32.5rem)
              width 65rem
              margin-top 0

            .lock
              position absolute
              top calc(50% - 1.5rem)
              left calc(50% - 3.5rem)
              width 7rem
              height 9rem
              background-image image('/pixelartacademy/pixelpad/apps/studyplan/lock.png')
              filter brightness(1)
