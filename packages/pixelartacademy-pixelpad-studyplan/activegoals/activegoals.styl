@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixelpad-apps-studyplan-activegoals
  left 10rem
  right calc(50% + 10rem)
  z-index 12

  .container
    .content
      .sections
        .section
          .explanation
            margin-left 5rem

          .goals
            list-style none
            margin 5rem 0 0 5rem
            padding 0

            .goal
              color atariGray(5)

              .name
                text-transform uppercase
                cursor pointer

                &:hover
                  color atariGray(6)

              .required-interests
                small-print()
