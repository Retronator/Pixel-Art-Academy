@import "{retronator:landsofillusions}/style/style.import"
@import "../style/style.import"

.pixelartdatabase-pixeldailies-pages-home
  .intro
    position relative
    padding 50rem 0 50rem
    min-height 67.2vw
    color atariGray(4)
    kyrou-9()
    line-height 14rem
    overflow hidden

    .page-content
      position relative
      z-index 1
      adventure-link()
      text-align justify
      hyphens auto
      background transparentify(atariGray(1), 0.8)
      box-shadow 2rem 2rem 0 atariGray(0),
                 0 10rem 20rem transparentify(atariGray(0), 0.5)

      a
        display inline
        border-bottom none
        text-decoration none
        color atariGray(6)

      strong
        kyrou-7()
        color atariGray(7)
        adventure-link()

        a
          padding-left 1rem
          line-height 8rem

          &:hover
          &:focus
            border-top 1rem solid atariGray(7)

      blockquote
        margin 0
        padding 0 2em
        border-left 1rem solid atariGray(4)
        color atariGray(3)
        line-height 11rem

        p:first-child::before
        p:last-child::after
          content '"'

      .video
        margin-top 5rem

      .welcome
        p:last-child
          adventure()
          text-align center
          text-wrap balance

    .background
      position absolute
      z-index 0
      top 0
      left 0
      right 0
      pixel-image-rendering()
      overflow hidden

      .image
        width 100%

      &::after
        content ''
        absolute-cover()
        z-index 0
        background linear-gradient(to top, rgba(atariGray(0), 100%) 0%, transparent 50%)

    .background-author
      position absolute
      z-index 2
      top 0
      right 0
      acme-9()
      color atariGray(7)
      font-size 16px
      padding 4rem
      opacity 0.7
      text-decoration none
      transition opacity 0.2s
      text-shadow 0 1rem 1rem black

      &:hover
        opacity 1

  .theme
    position relative

    .theme-link
      text-decoration none

    .pixelartdatabase-components-stream
      .artworks
        .artwork-area
          &:last-child
            .caption
              padding-bottom 40rem

    .view-all
      position absolute
      bottom 20rem
      left 0
      right 0
      text-shadow 0 1rem 2rem black
      text-align center

      .view-all-link
        opacity 0.6
        transition opacity 0.2s
        text-decoration none

        .hashtags
          text-decoration underline

        &:hover
        &:focus
         opacity 1
