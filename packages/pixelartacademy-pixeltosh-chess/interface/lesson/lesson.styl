@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixeltosh-programs-chess-interface-lesson
  position relative
  height 100%
  padding 11rem 12rem 0 0

  .pixeltosh
    float left
    width 19rem
    height 23rem
    margin 0 6rem 8rem 0
    background-image image('/pixelartacademy/pixeltosh/programs/chess/pixeltosh.png')

  .title
    text-transform uppercase

  .step
    clear both

    .actions
      position absolute
      bottom 12rem
      left 0
      right 12rem
      text-align center
