@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixeltosh-programs-chess-interface-earnings
  position absolute
  top 114rem
  left 160rem
  transform translate(-50%, -50%)
  padding 8rem 10rem

  .title
    margin-bottom 7rem
    chicago-mini()

  .rewards
    list-style none
    display grid
    margin 0
    padding 0
    grid-template-columns max-content max-content

    .reward
      display contents

      .name
        padding 0 20rem 3rem 0

      .value
        position relative
