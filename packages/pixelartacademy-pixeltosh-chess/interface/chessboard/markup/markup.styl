@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixeltosh-programs-chess-interface-chessboard-markup
  position absolute
  inset 4rem
  pointer-events none

  .target
  .legal-move-square
    position absolute
    width 20rem
    height 20rem

  .target
    background-image image('/pixelartacademy/pixeltosh/programs/chess/target.png')

  .legal-move-square
    background-image image('/pixelartacademy/pixeltosh/programs/chess/square-legalmove-hover.png')

  .arrow
    position absolute
    z-index 2
    transform-origin top left

    .straight
    .orthogonal
    .diagonal
      &::before
      &::after
        position absolute
        content ''

      &::before
        z-index 1

      &::after
        z-index 2

    .straight
      &::before
        left -5rem
        top -5rem
        bottom -3rem
        width 10rem
        background image('/pixelartacademy/pixeltosh/programs/chess/arrow-outline.png') 0 0 / 10rem 160rem

      &::after
        left -4rem
        top -3rem
        bottom -2rem
        width 8rem
        background image('/pixelartacademy/pixeltosh/programs/chess/arrow.png') 0 0 / 8rem 160rem

    .orthogonal
      &::before
        bottom -3rem
        left -3rem
        right -3rem
        height 6rem
        background-color white

      &::after
        bottom -2rem
        left -2rem
        right -2rem
        height 4rem
        background-color black

    .diagonal
      &::before
        inset -4rem -2rem -2rem -4rem
        background image('/pixelartacademy/pixeltosh/programs/chess/arrow-diagonal-outline.png') 0 0 / 160rem 160rem

      &::after
        inset -3rem -1rem -1rem -3rem
        background image('/pixelartacademy/pixeltosh/programs/chess/arrow-diagonal.png') 0 0 / 160rem 160rem

  .arrows
    .outline
    .fill
      absolute-cover()

    .outline
      z-index 1

      .arrow
        .straight
        .orthogonal
        .diagonal
          &::after
            display none

    .fill
      z-index 2

      .arrow
        .straight
        .orthogonal
        .diagonal
          &::before
            display none

    .arrow
      position absolute
      transform-origin top left

      .straight
      .orthogonal
      .diagonal
        &::before
        &::after
          z-index initial
