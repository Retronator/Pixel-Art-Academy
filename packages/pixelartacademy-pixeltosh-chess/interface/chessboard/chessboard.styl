@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixeltosh-programs-chess-interface-chessboard
  background white
  height 100%
  padding 12rem

  .board
    box-sizing border-box
    position relative
    width 177rem
    height 177rem
    padding 3rem
    border 1rem solid black

    .squares
      display flex
      flex-flow row wrap-reverse
      align-content flex-start
      gap 1rem
      background black
      border 1rem solid black

    &.flipped
      .squares
        flex-flow row-reverse wrap

      .coordinates
        .files
          .border
            flex-direction row-reverse

        .ranks
          .border
            flex-direction column

    .coordinates
      visibility hidden
      color black
      pixel-text-outline white true 1
      text-transform uppercase
      small-print()

      &.visible
        visibility visible

      .files
      .ranks
        .border
          display flex
          position absolute

      .files
        .border
          left 13rem

          .coordinate
            width 21rem

        .top
          top -5rem

        .bottom
          bottom -5rem

      .ranks
        .border
          top 11rem
          flex-direction column-reverse

          .coordinate
            height 21rem

        .left
          left -2rem

        .right
          right -3rem
