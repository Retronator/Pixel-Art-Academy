@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixeltosh-program-view.chess
.pixelartacademy-pixeltosh-chess
  .dark-interface &
    color white

    .currency::before
      filter invert(1)

  .currency::before
    content ''
    display inline-block
    width 6rem
    height 8rem
    margin-right 1rem
    vertical-align top
    background-image image('/pixelartacademy/pixeltosh/programs/chess/currency.png')

.pixelartacademy-pixeltosh-program-view.chess
  .light-interface &
    background-image image('/pixelartacademy/pixeltosh/os/program-background.png')

  .dark-interface &
    background-color black

    .fatamorgana-tabbedview
      .tabs
        border-bottom-color white

        .tab
          background black
          border-color white

          &.active
            &::after
              background black

    .pixelartacademy-pixeltosh-chess-interface-sidebar
      border-left-color white

  .fatamorgana-tabbedview
    display flex
    flex-direction column
    height 100%

    .tabs
      display flex
      border-bottom 1rem solid black
      background image('/pixelartacademy/pixeltosh/os/dither.png') 1rem 0 / 2rem 2rem

      .tab
        margin 1rem 1rem 0
        padding 0 2rem
        border 1rem solid black
        border-bottom none
        background white

        &.active
          position relative

          &::after
            content ''
            position absolute
            bottom -1rem
            left 0
            right 0
            height 1rem
            background white

    .active-tab
      position relative
      flex-grow 1
      padding 4rem

  .pixelartacademy-pixeltosh-chess-interface-sidebar
    border-left 1rem solid black
