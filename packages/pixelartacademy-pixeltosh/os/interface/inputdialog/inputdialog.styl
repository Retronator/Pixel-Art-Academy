@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixeltosh-os-interface-inputdialog
  absolute-cover()

  .dialog
    position absolute
    left 50%
    top 50%
    width 240rem
    padding 10rem
    transform translate(-50%, -50%)
    chicago-mini()

    .prompt
      margin 0.5rem 0 7.5rem
      line-height 10rem

    .input
      display block
      width 100%
      box-sizing border-box
      padding 3rem
      border 1rem solid black
      background white
      color black
      font inherit

    .actions
      margin-top 10rem
      text-align right

      .dialog-button
        min-width 44rem
        margin-left 8rem
