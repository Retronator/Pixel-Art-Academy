@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixeltosh-os-interface-button
  position relative
  border 1rem solid black
  border-image image('/pixelartacademy/pixeltosh/os/button-border.png') 4 fill / 4rem
  chicago-mini()
  padding 3rem
  color black

  &:active:not(:disabled)
    border-image-source image('/pixelartacademy/pixeltosh/os/button-border-active.png')
    color white

  &:disabled::after
    content ''
    position absolute
    inset 1rem
    background image('/pixelartacademy/pixeltosh/os/dither-white-16.png') 0 0 / 2rem 2rem

  &.mini
    border-image-source image('/pixelartacademy/pixeltosh/os/button-mini-border.png')
    geneva-mini()
    padding 0 0 0 1rem

    &:active:not(:disabled)
      border-image-source image('/pixelartacademy/pixeltosh/os/button-mini-border-active.png')
