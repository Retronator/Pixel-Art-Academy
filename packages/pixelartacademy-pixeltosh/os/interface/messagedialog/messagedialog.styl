@import "{retronator:retronator-identity}/style/style.import"

.pixelartacademy-pixeltosh-os-interface-messagedialog
  absolute-cover()

  .dialog
    position absolute
    left 50%
    top 50%
    width 240rem
    padding 10rem
    transform translate(-50%, -50%)
    chicago-mini()

    .message
      margin 0.5rem 0 10.5rem
      line-height 10rem

    .actions
      text-align right

      .dialog-button
        min-width 44rem
        margin-left 8rem
